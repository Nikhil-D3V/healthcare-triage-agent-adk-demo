# Copy to .env and fill in project-specific values.
# AUTH: deployment and BigQuery setup load ADC from this credential file.
# Override the path when running from another machine or environment.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\nikhi\Desktop\Projects\GE Webinar\d3v-agentspace-demo-4c8cfd668d80.json

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Staging bucket required by Agent Engine/Agent Runtime for deployment
# packaging (code + dependencies), NOT for storing clinical demo assets.
AGENT_ENGINE_STAGING_BUCKET=gs://your-project-agent-engine-staging

# BigQuery dataset holding the mock policy/eligibility tables in the
# deployed (non-local) configuration.
POLICY_BQ_DATASET=payer_policy_demo

# Dataset location for `bq mk --location=...` in setup_bigquery.sh. Use a
# value compatible with your Agent Runtime region (e.g. US, EU, us-central1).
BQ_LOCATION=US

# Switch for sub_agents/coverage_evaluator/tools.py:
#   local    -> reads mock_data/policy_rules.json (default, no GCP needed)
#   bigquery -> queries POLICY_BQ_DATASET (run deployment/setup_bigquery.sh first)
POLICY_DATA_BACKEND=local
